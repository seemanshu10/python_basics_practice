:: --------------- echo Command Example ---------------
@REM echo Hello, World!
@REM pause




@REM :: --------------- echo with @echo off ---------------
@REM echo off
@REM echo Line 1
@REM echo Line 2
@REM pause



@REM :: --------------- echo with @echo on ---------------
@REM echo on
@REM echo Line 1
@REM echo Line 2
@REM pause



:: --- Pause the script execution ---
echo Script finished
pause



:: --- Comment - Using REM (Remark) ---
REM This is a comment explaining the next line
echo Hello



:: --- Comment - Using double colons ---
:: This is another comment style
echo Hello
pause